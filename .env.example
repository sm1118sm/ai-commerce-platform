APP_ENV=development
# 비워두면 Docker Compose의 로컬 MySQL을 사용합니다.
# 로컬과 Render가 같은 관리형 MySQL을 쓰게 하려면 Aiven Service URI를 넣습니다.
# DATABASE_URL=mysql://avnadmin:URL_ENCODED_PASSWORD@host:port/defaultdb?ssl-mode=REQUIRED
DEMO_MODE=true
RECOMMENDER_BACKEND=tfidf
MYSQL_DATABASE=stylepick
MYSQL_USER=stylepick
MYSQL_PASSWORD=stylepick_dev_password
MYSQL_ROOT_PASSWORD=stylepick_root_dev_password
